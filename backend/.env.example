# Account storage. Set explicitly to retain or migrate an existing database.
AUTH_DATABASE_URL=sqlite:///./data/accounts.db
QUERYPULSE_DATA_DIR=./data
# Use a long random value; required in production.
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# Password recovery requires a STARTTLS SMTP server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local AI. Download the model with: ollama pull qwen2.5-coder:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
